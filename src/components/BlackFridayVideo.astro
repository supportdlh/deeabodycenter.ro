---
// Video-ul proprietarei pentru campania Black Friday (încărcat doar la play, cu subtitrare).
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import videoPoster from '../assets/black-friday/video-poster.jpg';

const poster = await getImage({ src: videoPoster, format: 'webp', width: 576 });
---

<figure class="bfv">
  <video
    controls
    playsinline
    preload="none"
    poster={poster.src}
    width="576"
    height="1024"
    aria-label={`Mesaj video de la ${site.name} despre campania Black Friday`}
  >
    <source src="/video/black-friday-deea.mp4" type="video/mp4" />
    <track kind="captions" src="/video/black-friday-deea.ro.vtt" srclang="ro" label="Română" default />
  </video>
  <figcaption>Un mesaj de la noi despre Black Friday</figcaption>
</figure>

<style>
  .bfv {
    margin: 0;
    width: 100%;
  }
  .bfv video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    border-radius: var(--r-lg);
    background: #000;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.15),
      0 20px 60px rgba(192, 38, 211, 0.35);
  }
  .bfv figcaption {
    text-align: center;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.75);
    margin-top: 10px;
  }
</style>
