---
// Un card de ofertă Black Friday: posterul (sau, fără poster, imaginea tratamentului cu
// numele și prețul suprapuse) + butonul „Comandă" pe WhatsApp.
import { Image } from 'astro:assets';
import { blackFriday } from '../data/blackFriday';
import type { BlackFridayOfferView } from '../data/blackFridayOffers';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  offer: BlackFridayOfferView;
  sizes: string;
  eager?: boolean;
}
const { offer, sizes, eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---

<div class="bfc">
  <a href={offer.href} class="bfc__media" aria-label={`${offer.alt}. Detalii despre tratament`}>
    {
      offer.poster ? (
        <Image src={offer.poster} alt="" widths={[320, 480, 640]} sizes={sizes} loading={loading} />
      ) : (
        <>
          <Image src={offer.photo} alt="" widths={[320, 480, 640]} sizes={sizes} loading={loading} />
          <span class="bfc__overlay" aria-hidden="true">
            <span class="bfc__overlay-name">{offer.name}</span>
            {offer.detail && <span class="bfc__overlay-detail">{offer.detail}</span>}
            <span class="bfc__overlay-price">{offer.price}</span>
            <span class="bfc__overlay-deal">{blackFriday.deal}</span>
          </span>
        </>
      )
    }
  </a>
  <a href={offer.wa} target="_blank" rel="noopener" class="btn btn-primary bfc__wa bf-live">
    <WhatsAppIcon />
    Comandă<span class="bf-sr-only"> pe WhatsApp: {offer.label}, {offer.price}</span>
  </a>
</div>

<style>
  .bfc {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
  }

  .bfc__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }
  .bfc__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--t-med);
  }
  .bfc__media:hover :global(img),
  .bfc__media:focus-visible :global(img) {
    transform: scale(1.03);
  }
  .bfc__media:focus-visible {
    outline: 3px solid #f6d9ff;
    outline-offset: 3px;
  }

  .bfc__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 16px;
    color: #fff;
    background: linear-gradient(180deg, transparent 35%, rgba(13, 7, 22, 0.92) 100%);
  }
  .bfc__overlay-name {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.1;
  }
  .bfc__overlay-detail {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .bfc__overlay-price {
    font-size: clamp(1.25rem, 3.5vw, 1.625rem);
    font-weight: 700;
    margin-top: 8px;
  }
  .bfc__overlay-deal {
    font-size: 0.875rem;
    font-weight: 600;
    color: #f6d9ff;
  }

  .bfc__wa {
    /* Ancorează textul .bf-sr-only (absolut) în buton, ca să nu iasă din caruselul cu scroll. */
    position: relative;
    justify-content: center;
    padding: 10px 12px;
    font-size: 0.875rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .bfc__media :global(img) {
      transition: none;
    }
  }
</style>
